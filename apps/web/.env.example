# Copia este archivo a .env.local y completa los valores (no se sube al repositorio).
# Ambos valores están en Supabase > Project Settings > API Keys / Data API.
NEXT_PUBLIC_SUPABASE_URL=https://TU-PROYECTO.supabase.co
# Clave publicable (sb_publishable_...). Es pública por diseño: la seguridad la dan las políticas RLS.
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_...
# URL pública del sitio, para los enlaces de confirmación y recuperación de contraseña.
NEXT_PUBLIC_SITE_URL=http://localhost:3000
# NUNCA pongas aquí la clave secreta (sb_secret_...) con prefijo NEXT_PUBLIC_.
# CAPTCHA (Cloudflare Turnstile). Opcional: sin esta variable el CAPTCHA queda desactivado.
# Clave de sitio (pública). Debe coincidir con el CAPTCHA activado en Supabase > Authentication > Attack Protection.
# NEXT_PUBLIC_TURNSTILE_SITE_KEY=0x...
# Clave secreta (sb_secret_...): SOLO SERVIDOR. Se salta RLS. La leen solo lib/supabase/admin.ts
# y estas rutas (sin ella responden 500 server_misconfigured):
#   POST   /api/subidas             guarda la imagen, registra la fila, candado y tope
#   DELETE /api/subidas/[id]        borra archivo y fila juntos
#   GET    /api/cuenta/exportar     candado y tope de exportaciones (los datos se leen con la sesión)
#   POST   /api/cuenta/eliminar     re-autenticación, bloqueo, borrado de archivos y de la cuenta
#   POST   /api/cuenta/reautenticar emite el intento de re-autenticación
#   acción updatePassword           consume el intento al cambiar la contraseña sin enlace de correo
# Nunca con prefijo NEXT_PUBLIC_, nunca en el navegador ni en el repositorio. En producción, en el
# gestor de secretos del hosting.
# Supabase > Project Settings > API Keys > Secret keys.
SUPABASE_SECRET_KEY=
